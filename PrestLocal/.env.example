# ============================================================================
# PrestLocal — modèle de configuration
# Copier ce fichier en `.env` puis remplir les valeurs :
#   cp .env.example .env
# Le fichier `.env` ne doit JAMAIS être commité (il est dans .gitignore).
# ============================================================================

# ---- Django ----------------------------------------------------------------
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
# En production : liste des domaines autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,*

# ---- Base de données -------------------------------------------------------
# Postgres (Neon / Docker). Laisser vide pour utiliser SQLite en local.
DATABASE_URL=postgresql://neondb_owner:REPLACE_WITH_NEON_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL=postgresql://prestalocal:prestalocal@db:5432/prestalocal

# ---- WebSocket / cache -----------------------------------------------------
# Laisser vide pour utiliser le canal mémoire (dev mono-processus).
REDIS_URL=redis://redis:6379/0

# ---- Email -----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Expéditeur affiché (par défaut : EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=
# Durée de validité des codes de vérification (minutes)
EMAIL_CODE_TTL_MINUTES=30

# ---- Sécurité / CORS (production) -----------------------------------------
# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Passer à True une fois le HTTPS actif pour forcer la redirection.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ---- Médias ----------------------------------------------------------------
# Sert les images via Django (dev). En production : nginx s'en charge.
SERVE_MEDIA=True

# ---- Limites anti-abus (DRF throttling) -----------------------------------
THROTTLE_ANON=240/hour
THROTTLE_USER=4000/hour
THROTTLE_AUTH=12/hour
THROTTLE_REVIEW=30/day
