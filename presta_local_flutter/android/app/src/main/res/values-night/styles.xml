<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème appliqué pendant le démarrage de l'application.
         Le splash natif affiche le logo LesProduFao (voir launch_background.xml). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Thème appliqué dès que le processus est lancé : détermine la couleur de
         la fenêtre pendant l'initialisation de l'UI Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
